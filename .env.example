# Copy this file to .env and adjust the values for your local setup.
ENV=dev

# Match these values to docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://lib_user:lib_pass@localhost:5432/library

# Development placeholder only. Use a private, randomly generated value outside local development.
JWT_SECRET=replace-with-a-long-random-secret-for-local-development
JWT_ISSUER=library-api
